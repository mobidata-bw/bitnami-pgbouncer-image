{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"git-submodules": {
		"enabled": true,
	},
	// run Renovate Bot less often
	"timezone": "Europe/Berlin",
	// Note: Renovate bot must have `*` for the minutes.
	"schedule": "* 07 * * 2", // every Tuesday at 7am
}
